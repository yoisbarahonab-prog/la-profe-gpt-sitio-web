# ==========================================
# CONFIGURACIÓN DE ENTORNO LOCAL - LA PROFE GPT
# Copia este archivo como `.env` y completa tus claves reales.
# ==========================================

# URL Base del Sitio (Desarrollo o Producción)
SITE_URL=http://localhost:8888

# 1. PASARELA DE PAGO: FLOW.CL (Sandbox / Producción)
# Obtén tus llaves en https://www.flow.cl/app/web/misLlaves.php
FLOW_API_KEY=tu_api_key_de_flow_aqui
FLOW_SECRET_KEY=tu_secret_key_de_flow_aqui
FLOW_API_URL=https://sandbox.flow.cl/api

# 2. CORREO TRANSACCIONAL: RESEND API
# Obtén tu clave en https://resend.com/api-keys
RESEND_API_KEY=re_123456789_tu_clave_resend_aqui
EMAIL_FROM="La Profe GPT <ventas@laprofegpt.cl>"

# Credenciales para admin
ADMIN_EMAIL=admin@admin.cl
ADMIN_PASSWORD=admin!1234

# 3. ENTORNO
NODE_ENV=development
